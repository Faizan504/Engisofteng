{"route":"/careers/","title":"Careers at ENGISOFT | BIM Jobs in Dubai","description":"Open BIM positions at ENGISOFT Engineering in Dubai: BIM architects and engineers. Apply online with your discipline, software and experience.","robots":"max-image-preview:large","canonical":"https://engisoftengineering.com/careers/","og":{"type":"website","title":"Careers at ENGISOFT | BIM Jobs in Dubai","description":"Open BIM positions at ENGISOFT Engineering in Dubai: BIM architects and engineers. Apply online with your discipline, software and experience.","url":"https://engisoftengineering.com/careers/","image":"https://engisoftengineering.com/assets/img/og-default.jpg","siteName":"ENGISOFT Engineering","locale":"en_US"},"twitter":"summary_large_image","jsonld":[{"@context":"https://schema.org","@graph":[{"@type":"ProfessionalService","@id":"https://engisoftengineering.com/#organization","name":"ENGISOFT Engineering","url":"https://engisoftengineering.com/","logo":"https://engisoftengineering.com/wp-content/themes/engisoft/assets/img/favicon.svg","image":"https://engisoftengineering.com/wp-content/uploads/engisoft-media/img/c-hand.jpg","email":"enquiry@engisoftengineering.com","telephone":"+971 58 867 2901","address":{"@type":"PostalAddress","streetAddress":"Office 608, Apricot Tower","addressLocality":"Dubai","addressRegion":"Dubai Silicon Oasis","addressCountry":"AE"},"areaServed":["AE","SA","QA","BH","KW","OM"],"sameAs":["https://www.linkedin.com/company/14517437/","https://www.instagram.com/engisoft.engineering/","https://www.facebook.com/Global.BIM.Leader","https://twitter.com/ENGISOFTDUBAI"]},{"@type":"WebSite","@id":"https://engisoftengineering.com/#website","url":"https://engisoftengineering.com/","name":"ENGISOFT Engineering","publisher":{"@id":"https://engisoftengineering.com/#organization"}},{"@type":"WebPage","name":"Careers","description":"Open BIM positions at ENGISOFT Engineering in Dubai: BIM architects and engineers. Apply online with your discipline, software and experience.","url":"https://engisoftengineering.com/careers/","isPartOf":{"@id":"https://engisoftengineering.com/#website"},"about":{"@id":"https://engisoftengineering.com/#organization"}}]},{"@context":"https://schema.org","@graph":[{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://engisoftengineering.com/"},{"@type":"ListItem","position":2,"name":"Careers","item":"https://engisoftengineering.com/careers/"}]}]}],"caseStudy":false,"main":"\n<section class=\"ph\"><video class=\"ph-media\" muted loop playsinline autoplay preload=\"metadata\" aria-hidden=\"true\"><source src=\"/assets/video/bim-workstation.mp4\" type=\"video/mp4\"></video><div class=\"ph-in\"><div><p class=\"crumb ph-a\"><a href=\"/\">Home</a> / Careers</p><h1 class=\"h1 ph-a\">Build a career<br><em>in BIM delivery.</em></h1></div><p class=\"lead ph-a\">ENGISOFT hires BIM architects, engineers, coordinators, modelers and drafters for projects in Dubai, the UAE and beyond.</p></div></section><section class=\"paper pad\"><div class=\"wrap wf\">\n  <div><p class=\"lab\">Open positions</p><h2 class=\"h2\">Roles we are <em>hiring for now.</em></h2>\n  <p class=\"lead\">Every hire goes through the same assessment we use for client placements: experience verification, a software test, a technical interview and a practical BIM exercise.</p>\n  <a class=\"btn dark\" style=\"margin-top:34px\" href=\"#apply\">Apply now <i aria-hidden=\"true\">&#8599;</i></a></div>\n  <ul class=\"rel\"><li><a href=\"#apply\" data-role=\"BIM Architect\" style=\"display:contents\"><b>BIM Architect</b><span>Architecture · 3–5 years</span><span class=\"l\">Immediate</span></a></li><li><a href=\"#apply\" data-role=\"Architecture BIM Engineer\" style=\"display:contents\"><b>Architecture BIM Engineer</b><span>Architecture · 3–5 years</span><span class=\"l\">Immediate</span></a></li><li><a href=\"#apply\" data-role=\"Structure BIM Engineer\" style=\"display:contents\"><b>Structure BIM Engineer</b><span>Structural · 3–5 years</span><span class=\"l\">Immediate</span></a></li></ul>\n</div></section>\n\n<section class=\"coal pad\"><div class=\"wrap\">\n  <div class=\"head\"><div><p class=\"lab\">How we hire</p><h2 class=\"h2\">Assessed like <em>our placements.</em></h2></div><a class=\"btn\" href=\"/verified-talent/\">Our assessment <i aria-hidden=\"true\">&#8599;</i></a></div>\n  <div class=\"flow f4\" style=\"--line:var(--line-d)\"><div class=\"rv\"><b>01</b><div><h3 class=\"h3\">Experience verification</h3><p>Employment history and project exposure reviewed against what the candidate claims.</p></div></div><div class=\"rv\"><b>02</b><div><h3 class=\"h3\">Software assessment</h3><p>Proficiency tested in the tools the role needs: Revit, Navisworks, ACC, Civil 3D and others.</p></div></div><div class=\"rv\"><b>03</b><div><h3 class=\"h3\">Technical interview</h3><p>Discipline-specific questions with an engineer, covering standards, LOD and coordination judgement.</p></div></div><div class=\"rv\"><b>04</b><div><h3 class=\"h3\">Practical BIM test</h3><p>A time-boxed exercise reproducing a realistic modelling or coordination task.</p></div></div></div>\n</div></section>\n\n<section class=\"paper pad\" id=\"apply\"><div class=\"wrap contact\">\n  <form class=\"form\" id=\"qform\" data-kind=\"application\" method=\"post\" action=\"/api/enquiry/\" novalidate>\n    <input type=\"hidden\" name=\"es_t\" value=\"1795280070.68447fd8c5ba8092\"><div style=\"position:absolute;left:-9999px\" aria-hidden=\"true\"><label>Website<input type=\"text\" name=\"website\" tabindex=\"-1\" autocomplete=\"off\"></label></div><input type=\"hidden\" name=\"action\" value=\"engisoft_enquiry\"><input type=\"hidden\" name=\"kind\" value=\"application\">\n    <div class=\"fr\"><label>Full name<input name=\"name\" required autocomplete=\"name\"></label><label>Email<input name=\"email\" type=\"email\" required autocomplete=\"email\"></label></div>\n    <div class=\"fr\"><label>Direct contact number<input name=\"phone\" type=\"tel\" required autocomplete=\"tel\"></label><label>Country<input name=\"country\" required autocomplete=\"country-name\" placeholder=\"e.g. United Arab Emirates\"></label></div>\n    <div class=\"fr\"><label>Position applying for<select name=\"position\" required id=\"es-pos\"><option>BIM Manager</option><option>BIM Coordinator</option><option>BIM Architect</option><option>BIM Engineer</option><option>BIM Modeler</option><option>Architect</option><option>Engineer</option><option>CAD Draftsman</option><option>Civil 3D Draftsman</option><option>Rebar Draftsman</option><option>Tekla Modeler</option><option>Interior Designer</option><option>3D Visualizer</option><option>Quality Engineer</option><option>Other</option></select></label><label>Discipline<select name=\"discipline\" required><option>Architecture</option><option>Structure</option><option>Mechanical</option><option>Plumbing &amp; Fire Fighting</option><option>Electrical</option><option>Facade</option><option>Landscape</option><option>Interior</option><option>P&amp;ID</option><option>Infrastructure (Underground Utilities)</option><option>Infrastructure (Roads &amp; Bridges)</option><option>Other</option></select></label></div>\n    <div class=\"fr\"><label>Years of experience<input name=\"experience\" required placeholder=\"e.g. 4 years, 2 in the GCC\"></label><label>Software<input name=\"software\" placeholder=\"e.g. Revit, Navisworks, Civil 3D\"></label></div>\n    <div class=\"fr\"><label>Current / last employer<input name=\"company\" autocomplete=\"organization\"></label><label>Availability / notice period<input name=\"notice\" placeholder=\"e.g. Immediate, 30 days\"></label></div>\n    <label>CV or portfolio link<input name=\"cv\" type=\"url\" placeholder=\"LinkedIn, Google Drive, Dropbox or portfolio URL\"></label>\n    <label>About you<textarea name=\"msg\" rows=\"4\" required placeholder=\"Projects you have worked on, your role and LOD, and the kind of work you are looking for\"></textarea></label>\n    <button class=\"btn\" type=\"submit\">Send application <i aria-hidden=\"true\">&#8599;</i></button>\n    <p class=\"fnote\" id=\"fnote\" aria-live=\"polite\">Your application goes straight to the ENGISOFT team.</p>\n  </form>\n  <div class=\"cinfo\">\n    <div class=\"cbox\"><h3>What happens next</h3><span>01 &middot; We review your profile against open and upcoming roles.</span><span>02 &middot; Shortlisted applicants take a software test and a technical interview.</span><span>03 &middot; References are checked with your current or last employer.</span></div>\n    <div class=\"cbox\"><h3>Prefer email?</h3><a href=\"mailto:enquiry@engisoftengineering.com?subject=Job%20application\">enquiry@engisoftengineering.com</a><span>Attach your CV and mention the position in the subject line.</span></div>\n  </div>\n</div></section>\n<script>document.querySelectorAll('[data-role]').forEach(function(a){a.addEventListener('click',function(){var s=document.getElementById('es-pos'),r=a.getAttribute('data-role');var b=-1,l=0;for(var i=0;i<s.options.length;i++){var o=s.options[i].text;if(r.indexOf(o)>-1&&o.length>l){b=i;l=o.length;}}if(b>-1)s.selectedIndex=b;});});</script>\n","cta":"<img class=\"bg\" srcset=\"/assets/img/team-960.jpg 960w, /assets/img/team.jpg 1920w\" sizes=\"100vw\" src=\"/assets/img/team.jpg\" alt=\"ENGISOFT engineers reviewing a project together\" loading=\"lazy\">    <p class=\"lab\">Next step</p><h2 class=\"display\" style=\"margin-top:20px\">Not the right role? <em>Apply anyway.</em></h2>\n    <div class=\"btns\"><a class=\"btn\" href=\"/request-talent/\">Request BIM professionals <i aria-hidden=\"true\">&#8599;</i></a><a class=\"btn ghost\" href=\"tel:+971588672901\">+971 58 867 2901</a></div>"}