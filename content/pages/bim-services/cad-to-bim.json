s=\"chiprow \"><span>AutoCAD</span><span>Revit</span><span>Navisworks</span><span>IFC</span></div></div>  </div>\n</div></section>\n\n\n\n<section class=\"coal pad\"><div class=\"wrap\"><div class=\"head\"><div><p class=\"lab\">Delivery workflow</p><h2 class=\"h2\">How CAD to BIM Conversion <em>runs.</em></h2></div><p class=\"lead\">Five stages, with QA/QC before anything is issued.</p></div>\n  <div class=\"flow f5\"><div class=\"rv\"><b>01</b><div><h3 class=\"h3\">Scope &amp; BEP</h3><p>Confirm deliverables, LOD/LOI matrix and standards.</p></div></div><div class=\"rv\"><b>02</b><div><h3 class=\"h3\">Audit the source</h3><p>DWG and PDF sets reviewed for completeness, scale, levels and conflicts before modelling starts.</p></div></div><div class=\"rv\"><b>03</b><div><h3 class=\"h3\">Model</h3><p>Grids, levels and discipline elements built in Revit to the agreed LOD, with project families and parameters.</p></div></div><div class=\"rv\"><b>04</b><div><h3 class=\"h3\">QA/QC</h3><p>Run model health, standards and clash checks before issue.</p></div></div><div class=\"rv\"><b>05</b><div><h3 class=\"h3\">Verify</h3><p>The model overlaid on the source drawings, discrepancies logged and sheets regenerated from the model.</p></div></div></div>\n</div></section>\n\n\n<section class=\"pad\"><div class=\"wrap pn\">\n  <a href=\"/bim-services/revit-family-creation/\"><img width=\"1920\" height=\"1280\" src=\"/assets/uploads/2026/11/engisoft-architect.jpg\" class=\"attachment-full size-full\" alt=\"Architect marking up construction drawings by hand\" sizes=\"auto, (max-width:900px) 100vw, 50vw\" loading=\"lazy\" decoding=\"async\" srcset=\"/assets/uploads/2026/11/engisoft-architect.jpg 1920w, /assets/uploads/2026/11/engisoft-architect-300x200.jpg 300w, /assets/uploads/2026/11/engisoft-architect-1024x683.jpg 1024w, /assets/uploads/2026/11/engisoft-architect-768x512.jpg 768w, /assets/uploads/2026/11/engisoft-architect-1536x1024.jpg 1536w\" /><span class=\"lab\">Previous service</span><h2 class=\"h2\" style=\"margin-top:12px\">Revit Family Creation</h2></a>\n  <a href=\"/bim-services/bim-modeling/\"><img width=\"1920\" height=\"1080\" src=\"/assets/uploads/2026/11/engisoft-c-hand.jpg\" class=\"attachment-full size-full\" alt=\"Aerial view of a completed villa roof and terraces at night\" sizes=\"auto, (max-width:900px) 100vw, 50vw\" loading=\"lazy\" decoding=\"async\" srcset=\"/assets/uploads/2026/11/engisoft-c-hand.jpg 1920w, /assets/uploads/2026/11/engisoft-c-hand-300x169.jpg 300w, /assets/uploads/2026/11/engisoft-c-hand-1024x576.jpg 1024w, /assets/uploads/2026/11/engisoft-c-hand-768x432.jpg 768w, /assets/uploads/2026/11/engisoft-c-hand-1536x864.jpg 1536w\" /><span class=\"lab\">Next service</span><h2 class=\"h2\" style=\"margin-top:12px\">BIM Modeling</h2></a>\n</div></section>\n","cta":"<img class=\"bg\" srcset=\"/assets/img/dxb-night-960.jpg 960w, /assets/img/dxb-night.jpg 1920w\" sizes=\"100vw\" src=\"/assets/img/dxb-night.jpg\" alt=\"Dubai Marina towers lit at night\" loading=\"lazy\">    <p class=\"lab\">Next step</p><h2 class=\"display\" style=\"margin-top:20px\">Start your <em>cad to BIM conversion scope.</em></h2>\n    <div class=\"btns\"><a class=\"btn\" href=\"/request-talent/\">Request BIM professionals <i aria-hidden=\"true\">&#8599;</i></a><a class=\"btn ghost\" href=\"tel:+971588672901\">+971 58 867 2901</a></div>"}